{
    "name": "@dintero/node-sdk",
    "version": "1.4.17",
    "description": "Node.js library for the Dintero API",
    "main": "./dist/dintero.js",
    "typings": "./dist/dintero.d.ts",
    "files": [
        "dist"
    ],
    "license": "MIT",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "author": "Dintero <support@dintero.com> (https://dintero.com/)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Dintero/Dintero.Node.SDK.git"
    },
    "homepage": "https://github.com/Dintero/Dintero.Node.SDK",
    "bugs": {
        "url": "https://github.com/Dintero/Dintero.Node.SDK/issues"
    },
    "scripts": {
        "build": "tsc --noEmit && pnpm run build-ts && pnpm run lint",
        "build-ts": "tsc -p ./tsconfig.build.json",
        "test": "node --import tsx --test test/*.test.ts",
        "lint": "biome check",
        "convert-spec": "tsx scripts/convert-spec.ts",
        "prepublishOnly": "pnpm run build-ts"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.8",
        "@types/node": "26.6.6",
        "msw": "3.0.6",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "openapi-fetch": "^0.17.0"
    },
    "packageManager": "pnpm@12.24.0+sha512.5f90f50a48aa40f01dc43bd3acb528922fd899d3b909015fdb23af73bb31c578f29ceb29be9a4d6f0146adb34206aac332796043cc5024b815ef76288cbac767"
}
